# Application
APP_URL=https://app.example.com
NODE_ENV=development
DEPLOYMENT_MODE=SAAS
DEFAULT_LOCALE=de-DE
DEFAULT_TIMEZONE=Europe/Berlin

# Persistence
DATABASE_URL=replace-with-your-postgresql-connection-string
REDIS_URL=replace-with-your-redis-connection-string

# Authentication
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_URL=replace-with-your-auth-url

# Meta integration (configure only after verifying the current official API contract)
META_APP_ID=replace-me
META_APP_SECRET=replace-me
META_CALLBACK_URL=replace-with-your-meta-callback-url
META_API_VERSION=v26.0
TOKEN_ENCRYPTION_KEY=replace-with-a-32-byte-secret

# AI providers (provider adapters decide which are required)
AI_TEXT_PROVIDER=replace-me
AI_TEXT_API_KEY=replace-me
AI_IMAGE_PROVIDER=replace-me
AI_IMAGE_API_KEY=replace-me
AI_ANALYSIS_PROVIDER=replace-me
AI_ANALYSIS_API_KEY=replace-me

# S3-compatible object storage
S3_ENDPOINT=replace-with-your-s3-endpoint
S3_REGION=eu-central-1
S3_BUCKET=meta-ads-saas
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me

# Email adapter
EMAIL_PROVIDER=replace-me
EMAIL_FROM=replace-with-your-sender-address
EMAIL_API_KEY=replace-me

# Optional billing/licensing adapters
BILLING_PROVIDER=disabled
BILLING_API_KEY=replace-me
LICENSE_PUBLIC_KEY=replace-me

# Operational controls
LOG_LEVEL=info
JOB_CONCURRENCY=5
